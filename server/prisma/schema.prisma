// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  LEARNER
  QUESTION_MANAGER
  ADMIN

  @@map("user_role")
}

enum AccountStatus {
  ACTIVE
  BLOCKED

  @@map("account_status")
}

model User {
  id                   String               @id @default(uuid()) @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  username             String               @unique @db.VarChar(50)
  email                String               @unique @db.VarChar(255)
  passwordHash         String               @map("password_hash") @db.VarChar(255)
  role                 UserRole             @default(LEARNER)
  status               AccountStatus        @default(ACTIVE)

  questionsAuthored    Question[]           @relation("QuestionAuthor")
  questionsReviewed    Question[]           @relation("QuestionReviewer")
  attempts             Attempt[]

  sessions             Session[]

  @@map("users")
}

// A login session. The id is a long random token generated by the server
// and stored in the session cookie, so it must be unguessable.
model Session {
  id                   String               @id
  createdAt            DateTime             @default(now()) @map("created_at")
  expiresAt            DateTime             @map("expires_at")
  userId               String               @map("user_id") @db.Uuid
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum QuestionAnswerType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  ESSAY

  @@map("question_answer_type")
}

enum QuestionReviewStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  FLAGGED

  @@map("question_review_status")
}

model Question {
  id                   String               @id @default(uuid()) @db.Uuid
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  content              Json                 @db.JsonB
  answerKey            Json                 @map("answer_key") @db.JsonB
  answerType           QuestionAnswerType   @map("answer_type")

  category             String               @db.VarChar(100)
  difficulty           String?              @db.VarChar(50)

  reviewStatus         QuestionReviewStatus @default(DRAFT) @map("review_status")
  reviewedAt           DateTime?            @map("reviewed_at")
  reviewedById         String?              @map("reviewed_by_id") @db.Uuid
  flaggedAt            DateTime?            @map("flagged_at")
  flaggedReason        String?              @map("flagged_reason")

  authorId             String               @map("author_id") @db.Uuid
  author               User                 @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  reviewedBy           User?                @relation("QuestionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  attemptQuestions     AttemptQuestion[]

  @@index([authorId])
  @@index([reviewStatus, category])
  @@index([reviewedById])
  @@map("questions")
}

model Attempt {
  id                   String               @id @default(uuid()) @db.Uuid
  startedAt            DateTime             @default(now()) @map("started_at")
  finishedAt           DateTime?            @map("finished_at")
  score                Int?
  category             String               @db.VarChar(100)

  userId               String               @map("user_id") @db.Uuid
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions            AttemptQuestion[]

  @@index([userId, finishedAt])
  @@map("attempts")
}

model AttemptQuestion {
  id                   String               @id @default(uuid()) @db.Uuid
  position             Int
  content              Json                 @db.JsonB
  answerType           QuestionAnswerType   @map("answer_type")
  answerKey            Json                 @map("answer_key") @db.JsonB
  answer               Json?                @db.JsonB
  isCorrect            Boolean?             @map("is_correct")

  attemptId            String               @map("attempt_id") @db.Uuid
  attempt              Attempt              @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId           String               @map("question_id") @db.Uuid
  question             Question             @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, position])
  @@index([questionId])
  @@map("attempt_questions")
}